# Copia questo file in .env e inserisci i tuoi valori.
# Il file .env non va mai caricato su GitHub.
PORT=3000

# Chiave API di OpenAI (platform.openai.com, sezione API keys)
OPENAI_API_KEY=

# Stringa di connessione di MongoDB Atlas (Connect > Drivers)
MONGODB_URI=

# Solo online: indirizzo del front end su Netlify, l'unico a cui il server
# risponde. In locale si lascia vuoto
CLIENT_URL=

# Solo online: chiave segreta richiesta da POST /api/courses/ingest
# (header x-admin-key). In locale si lascia vuoto
ADMIN_KEY=
